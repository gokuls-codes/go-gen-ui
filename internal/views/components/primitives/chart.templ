package primitives

import "encoding/json"

// ChartItem represents a single data point in the Chart primitive.
type ChartItem struct {
	Label   string
	Value   float64
	Display string
}

// ChartProps defines the configurable properties for the Chart primitive.
type ChartProps struct {
	Title     string
	ChartType string // "bar" (default), "doughnut", "pie", "line"
	Items     []ChartItem
	Class     string
	Attrs     templ.Attributes
}

type chartDataPayload struct {
	Type     string    `json:"type"`
	Title    string    `json:"title,omitempty"`
	Labels   []string  `json:"labels"`
	Values   []float64 `json:"values"`
	Displays []string  `json:"displays,omitempty"`
}

func chartTypeOrDefault(t string) string {
	switch t {
	case "doughnut", "pie", "line":
		return t
	default:
		return "bar"
	}
}

func chartPayloadJSON(props ChartProps) string {
	labels := make([]string, 0, len(props.Items))
	values := make([]float64, 0, len(props.Items))
	displays := make([]string, 0, len(props.Items))

	for _, item := range props.Items {
		labels = append(labels, item.Label)
		values = append(values, item.Value)
		displays = append(displays, item.Display)
	}

	raw, err := json.Marshal(chartDataPayload{
		Type:     chartTypeOrDefault(props.ChartType),
		Title:    props.Title,
		Labels:   labels,
		Values:   values,
		Displays: displays,
	})
	if err != nil {
		return "{}"
	}
	return string(raw)
}

// Chart renders a responsive Chart.js canvas initialized by HTMX after swap.
templ Chart(props ChartProps) {
	<div
		class={
			"w-full space-y-2",
			props.Class,
		}
		{ props.Attrs... }
	>
		if props.Title != "" {
			<h4 class="text-sm font-semibold text-foreground">{ props.Title }</h4>
		}
		<div class="relative h-64 w-full">
			<canvas data-chart={ chartPayloadJSON(props) }></canvas>
		</div>
	</div>
}
