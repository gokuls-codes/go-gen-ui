package components

import "fmt"

templ ChatMessage(message string, isUser bool) {
	<div
		class={
			"w-fit max-w-md px-4 py-2 rounded-lg text-sm shadow-sm whitespace-pre-wrap leading-relaxed",
			templ.KV("ml-auto bg-primary text-primary-foreground rounded-br-none", isUser),
			templ.KV("mr-auto bg-card text-card-foreground border border-border rounded-bl-none", !isUser),
		}
	>
		{ message }
	</div>
}

templ ChatExchange(userMessage, aiResponse string) {
	@ChatMessage(userMessage, true)
	@ChatMessage(aiResponse, false)
}

templ ChatPendingExchange(userMessage, msgId, threadId string) {
	@ChatMessage(userMessage, true)

	<div
		data-chat-reply
		hx-post={ fmt.Sprintf("/chat/reply?thread_id=%s&msg_id=%s", threadId, msgId) }
		hx-trigger="load"
		hx-swap="outerHTML"
		class="w-fit max-w-md px-4 py-2 rounded-lg text-sm shadow-sm mr-auto bg-card text-muted-foreground border border-border rounded-bl-none animate-pulse"
	>
		Thinking...
	</div>
}

templ ChatAssistantResponse(text string, widgets []templ.Component) {
	<div class="space-y-3 mr-auto w-full">
		if text != "" {
			@ChatMessage(text, false)
		}
		for _, widget := range widgets {
			@widget
		}
	</div>
}