package views

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
		</head>
		<body class="bg-gray-50 text-gray-900 min-h-screen">
			{ children... }
		</body>
	</html>
}