package pages

import "github.com/gokuls-codes/go-gen-ui/internal/views"

templ Index() {
    @views.Base("Gen UI Playground") {
        <main class="max-w-2xl mx-auto p-6">
            <h1 class="text-3xl font-bold mb-4">Gen UI Playground</h1>
            
            <div id="result" class="p-4 bg-white rounded border my-4">
                Click the button to test HTMX.
            </div>

            <button 
                hx-get="/ping" 
                hx-target="#result" 
                class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                Ping with HTMX
            </button>
        </main>
    }
}